{
  "name": "@senda/extension",
  "description": "Senda browser extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:store": "SENDA_STORE=1 wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "fixtures": "node tests/fixtures/server.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@senda/adapter-schema": "workspace:*",
    "@senda/protocol": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
