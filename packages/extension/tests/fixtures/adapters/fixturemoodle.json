{
  "id": "fixturemoodle",
  "name": "Fixture Moodle",
  "version": "1.0.0",
  "engine": 1,
  "source": "local",
  "sites": ["http://127.0.0.1:18766/moodle/*"],
  "start_url": "http://127.0.0.1:18766/moodle/my/",
  "mode": "write",
  "description": "Read and edit fixture Moodle data",
  "login_check": { "exists": "a[href*='logout.php']" },
  "read_endpoints": ["/moodle/lib/ajax/service.php"],
  "tools": {
    "my_courses": {
      "description": "List courses",
      "effect": "read",
      "params": {},
      "steps": [
        {
          "extract": { "selector": "a[href*='logout.php']", "attr": "href", "pattern": "sesskey=([^&]+)" },
          "save": "sesskey"
        },
        {
          "request": {
            "method": "POST",
            "path": "/moodle/lib/ajax/service.php",
            "query": {
              "sesskey": "{{vars.sesskey}}",
              "info": "core_course_get_enrolled_courses_by_timeline_classification"
            },
            "json": [
              { "index": 0, "methodname": "core_course_get_enrolled_courses_by_timeline_classification", "args": {} }
            ]
          },
          "save": "response"
        },
        { "pick": { "from": "response", "path": "0.data.courses" }, "save": "courses" },
        { "return": "courses" }
      ]
    },
    "upcoming_deadlines": {
      "description": "Get deadlines",
      "effect": "read",
      "params": {},
      "steps": [
        {
          "extract": { "selector": "a[href*='logout.php']", "attr": "href", "pattern": "sesskey=([^&]+)" },
          "save": "sesskey"
        },
        {
          "request": {
            "method": "POST",
            "path": "/moodle/lib/ajax/service.php",
            "query": { "sesskey": "{{vars.sesskey}}", "info": "core_calendar_get_action_events_by_timesort" },
            "json": [
              {
                "index": 0,
                "methodname": "core_calendar_get_action_events_by_timesort",
                "args": { "timesortfrom": "{{now}}", "limitnum": 20 }
              }
            ]
          },
          "save": "response"
        },
        { "pick": { "from": "response", "path": "0.data.events" }, "save": "events" },
        { "return": "events" }
      ]
    },
    "rename_course": {
      "description": "Rename a course",
      "effect": "write",
      "confirm": "Rename course {{args.id}}: {{vars.old_full}} → {{args.fullname}}",
      "params": {
        "id": { "type": "number", "required": true },
        "fullname": { "type": "string", "required": true },
        "shortname": { "type": "string", "required": true }
      },
      "steps": [
        { "navigate": { "url": "http://127.0.0.1:18766/moodle/course/edit.php?id={{args.id}}" } },
        { "extract": { "selector": "#id_fullname", "attr": "value" }, "save": "old_full" },
        { "extract": { "selector": "#id_shortname", "attr": "value" }, "save": "old_short" },
        { "type": { "selector": "#id_fullname", "text": "{{args.fullname}}" } },
        { "type": { "selector": "#id_shortname", "text": "{{args.shortname}}" } },
        { "submit": { "selector": "form" } },
        { "return": { "fullname": "old_full", "shortname": "old_short" } }
      ]
    }
  }
}
