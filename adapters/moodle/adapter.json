{
  "id": "moodle",
  "name": "Moodle",
  "version": "1.1.0",
  "engine": 1,
  "source": "official",
  "template": { "site": { "description": "Your Moodle address, e.g. https://moodle.school.edu", "example": "https://moodle.school.edu" } },
  "sites": ["{{site}}/*"],
  "start_url": "{{site}}/my/",
  "mode": "write",
  "description": "Find courses and deadlines, view course settings, and rename courses.",
  "login_check": { "exists": "a[href*='logout.php']" },
  "read_endpoints": ["{{site_path}}/lib/ajax/service.php"],
  "tools": {
    "my_courses": {
      "description": "Show your courses.", "effect": "read",
      "params": { "classification": { "type": "string", "default": "inprogress", "description": "Choose inprogress or all." } },
      "steps": [
        { "extract": { "selector": "a[href*='logout.php']", "attr": "href", "pattern": "sesskey=([^&]+)" }, "save": "sesskey" },
        { "request": { "method": "POST", "path": "{{site_path}}/lib/ajax/service.php", "query": { "sesskey": "{{vars.sesskey}}", "info": "core_course_get_enrolled_courses_by_timeline_classification" }, "json": [{ "index": 0, "methodname": "core_course_get_enrolled_courses_by_timeline_classification", "args": { "classification": "{{args.classification}}", "limit": 20 } }] }, "save": "response" },
        { "pick": { "from": "response", "path": "0.data.courses" }, "save": "courses" },
        { "map": { "from": "courses", "fields": { "id": "id", "fullname": "fullname", "shortname": "shortname", "viewurl": "viewurl" } }, "save": "courses" },
        { "return": "courses" }
      ]
    },
    "upcoming_deadlines": {
      "description": "Show upcoming deadlines.", "effect": "read", "params": {},
      "steps": [
        { "extract": { "selector": "a[href*='logout.php']", "attr": "href", "pattern": "sesskey=([^&]+)" }, "save": "sesskey" },
        { "request": { "method": "POST", "path": "{{site_path}}/lib/ajax/service.php", "query": { "sesskey": "{{vars.sesskey}}", "info": "core_calendar_get_action_events_by_timesort" }, "json": [{ "index": 0, "methodname": "core_calendar_get_action_events_by_timesort", "args": { "timesortfrom": "{{now}}", "limitnum": 20 } }] }, "save": "response" },
        { "pick": { "from": "response", "path": "0.data.events" }, "save": "events" },
        { "map": { "from": "events", "fields": { "name": "name", "timesort": "timesort", "url": "url" } }, "save": "events" },
        { "return": "events" }
      ]
    },
    "search_courses": {
      "description": "Find courses by name.", "effect": "read",
      "params": { "query": { "type": "string", "required": true, "description": "Words to find in course names." } },
      "steps": [
        { "extract": { "selector": "a[href*='logout.php']", "attr": "href", "pattern": "sesskey=([^&]+)" }, "save": "sesskey" },
        { "request": { "method": "POST", "path": "{{site_path}}/lib/ajax/service.php", "query": { "sesskey": "{{vars.sesskey}}", "info": "core_course_search_courses" }, "json": [{ "index": 0, "methodname": "core_course_search_courses", "args": { "criterianame": "search", "criteriavalue": "{{args.query}}", "page": 0, "perpage": 20 } }] }, "save": "response" },
        { "pick": { "from": "response", "path": "0.data.courses" }, "save": "courses" },
        { "map": { "from": "courses", "fields": { "id": "id", "fullname": "fullname", "shortname": "shortname", "categoryname": "categoryname" } }, "save": "courses" },
        { "return": "courses" }
      ]
    },
    "get_course": {
      "description": "View a course's current name and short name.", "effect": "read",
      "params": { "course_id": { "type": "number", "required": true, "description": "Course number." } },
      "steps": [
        { "navigate": { "url": "{{site}}/course/edit.php?id={{args.course_id}}" } },
        { "wait_for": { "selector": "#id_fullname" } },
        { "extract": { "selector": "#id_fullname", "attr": "value" }, "save": "fullname" },
        { "extract": { "selector": "#id_shortname", "attr": "value" }, "save": "shortname" },
        { "return": { "fullname": "fullname", "shortname": "shortname" } }
      ]
    },
    "rename_course": {
      "description": "Change a course's full and short names.", "effect": "write",
      "confirm": "Rename course {{args.course_id}} from {{vars.old_full}} / {{vars.old_short}} to {{args.fullname}} / {{args.shortname}}?",
      "params": { "course_id": { "type": "number", "required": true }, "fullname": { "type": "string", "required": true }, "shortname": { "type": "string", "required": true } },
      "steps": [
        { "navigate": { "url": "{{site}}/course/edit.php?id={{args.course_id}}" } },
        { "wait_for": { "selector": "#id_fullname" } },
        { "extract": { "selector": "#id_fullname", "attr": "value" }, "save": "old_full" },
        { "extract": { "selector": "#id_shortname", "attr": "value" }, "save": "old_short" },
        { "type": { "selector": "#id_fullname", "text": "{{args.fullname}}" } },
        { "type": { "selector": "#id_shortname", "text": "{{args.shortname}}" } },
        { "click": { "selector": "#id_saveanddisplay" } },
        { "wait_for": { "selector": "body.path-course-view" } },
        { "navigate": { "url": "{{site}}/course/edit.php?id={{args.course_id}}" } },
        { "wait_for": { "selector": "#id_fullname" } },
        { "extract": { "selector": "#id_fullname", "attr": "value" }, "save": "new_full" },
        { "extract": { "selector": "#id_shortname", "attr": "value" }, "save": "new_short" },
        { "return": { "old_full": "old_full", "old_short": "old_short", "fullname": "new_full", "shortname": "new_short" } }
      ]
    }
  },
  "i18n": {
    "es": {
      "description": "Busca cursos y fechas de entrega, mira la configuración de un curso y cambia el nombre de los cursos.",
      "site": "La dirección de tu Moodle, p. ej. https://moodle.colegio.edu",
      "tools": {
        "my_courses": { "description": "Muestra tus cursos." },
        "upcoming_deadlines": { "description": "Muestra las próximas fechas de entrega." },
        "search_courses": { "description": "Busca cursos por nombre." },
        "get_course": { "description": "Muestra el nombre completo y el nombre corto actuales de un curso." },
        "rename_course": { "description": "Cambia el nombre completo y el nombre corto de un curso." }
      }
    }
  }
}
